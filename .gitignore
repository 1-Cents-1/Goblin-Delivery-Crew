# Goblin Delivery Crew - Unity / Git ignore rules
#
# This file must be named exactly ".gitignore" and placed at the Git repository root.
# The Unity-generated folder patterns below are intentionally not root-anchored,
# so they also work if the Unity project is temporarily nested inside the repository.

# Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/

# Local Goblin Delivery Crew developer sandboxes
# Shared SystemTests scenes remain tracked.
**/[Aa]ssets/_GDC/[Ss]cenes/[Dd]evelopment/[Pp]ersonal/

# Unity crash and diagnostic files
sysinfo.txt
mono_crash.*
*.log

# Blender backup files
*.blend1
*.blend1.meta

# Autogenerated JetBrains Rider plugin and personal settings
**/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
.idea/

# Visual Studio, VS Code, MonoDevelop, and other IDE files
.vs/
.vscode/
.gradle/
[Ee]xported[Oo]bj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated metadata for ignored debugger files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Packaged build artifacts
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Unity generated backup folders beside builds
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/

# Crashlytics generated file
crashlytics-build.properties

# Test Runner generated scenes
[Ii]nit[Tt]est[Ss]cene*.unity*
**/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables generated output
[Ss]erver[Dd]ata/
**/[Aa]ssets/StreamingAssets/aa*
**/[Aa]ssets/AddressableAssetsData/link.xml*
**/[Aa]ssets/Addressables_Temp*
**/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated files
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scene dependency cache
**/[Aa]ssets/[Ss]ceneDependencyCache*

# Local environment and secret files
.env
.env.*
!.env.example

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

